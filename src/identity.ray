// Identidad Ed25519 + X25519 (derivada) y nick persistidos.
import std/crypto;
import std/fs;
import std/hex;

pub const SEED_LEN: int = 32;
pub const PUBKEY_LEN: int = 32;
pub const SIG_LEN: int = 64;

const X25519_INFO: bytes = b"msg-identity-x25519-v1";

/// Local peer identity: Ed25519 seed/pubkey, derived X25519 pair, and display nick.
pub struct Identity {
    seed: bytes,
    pubkey: bytes,
    x_secret: bytes,
    x_pubkey: bytes,
    nick: string,
}

/// Default config dir: `$MSG_HOME`, else `$HOME/.config/msg`, else `./.msg`.
pub fn default_config_dir() -> string {
    match (env("MSG_HOME")) {
        Option.Some(p) => p,
        Option.None => match (env("HOME")) {
            Option.Some(h) => h + "/.config/msg",
            Option.None => "./.msg",
        },
    }
}

fn seed_path(dir: string) -> string { dir + "/identity.seed" }
fn nick_path(dir: string) -> string { dir + "/nick" }

fn empty_bytes() -> bytes {
    let none: [int] = [];
    bytes_of(none)
}

/// Derives the long-term X25519 secret from the Ed25519 seed (HKDF).
pub fn derive_x25519_secret(seed: bytes) -> Result<bytes, string> {
    match (crypto.hkdf_sha256(empty_bytes(), seed, X25519_INFO, SEED_LEN)) {
        Option.None => Result.Err("x25519 derive failed"),
        Option.Some(sk) => Result.Ok(sk),
    }
}

pub fn complete_identity(seed: bytes, pubkey: bytes, nick: string) -> Result<Identity, string> {
    match (derive_x25519_secret(seed)) {
        Result.Err(e) => Result.Err(e),
        Result.Ok(x_secret) => match (crypto.x25519_public_key(x_secret)) {
            Option.None => Result.Err("x25519 public key failed"),
            Option.Some(x_pubkey) => Result.Ok(Identity {
                seed: seed,
                pubkey: pubkey,
                x_secret: x_secret,
                x_pubkey: x_pubkey,
                nick: nick,
            }),
        },
    }
}

/// Short hex fingerprint of a public key (first 8 bytes).
pub fn fingerprint(pubkey: bytes) -> string {
    let h = hex.hex_encode(pubkey);
    if (h.len() < 16) { h } else { h.substring(0, 16) }
}

fn ensure_dir(dir: string) -> Result<int, string> {
    if (fs.exists(dir)) {
        Result.Ok(0)
    } else {
        fs.mkdir(dir)
    }
}

fn load_or_create_seed(dir: string) -> Result<bytes, string> {
    let path = seed_path(dir);
    if (fs.exists(path)) {
        match (fs.read_file_bytes(path)) {
            Result.Err(e) => Result.Err(e),
            Result.Ok(raw) => {
                if (raw.len() == SEED_LEN) {
                    Result.Ok(raw)
                } else {
                    match (from_utf8(raw)) {
                        Result.Err(_) => Result.Err("invalid identity.seed"),
                        Result.Ok(s) => hex.hex_decode(s.trim()),
                    }
                }
            },
        }
    } else {
        let seed = crypto.random_bytes(SEED_LEN);
        match (ensure_dir(dir)) {
            Result.Err(e) => Result.Err(e),
            Result.Ok(_) => match (fs.write_file_bytes(path, seed)) {
                Result.Err(e) => Result.Err(e),
                Result.Ok(_) => Result.Ok(seed),
            },
        }
    }
}

fn load_or_create_nick(dir: string, override_nick: string) -> Result<string, string> {
    if (override_nick.len() > 0) {
        match (ensure_dir(dir)) {
            Result.Err(e) => Result.Err(e),
            Result.Ok(_) => match (fs.write_file(nick_path(dir), override_nick + "\n")) {
                Result.Err(e) => Result.Err(e),
                Result.Ok(_) => Result.Ok(override_nick),
            },
        }
    } else {
        let path = nick_path(dir);
        if (fs.exists(path)) {
            match (fs.read_file(path)) {
                Result.Err(e) => Result.Err(e),
                Result.Ok(s) => {
                    let n = s.trim();
                    if (n.len() == 0) { Result.Ok("anon") } else { Result.Ok(n) }
                },
            }
        } else {
            let n = "anon";
            match (ensure_dir(dir)) {
                Result.Err(e) => Result.Err(e),
                Result.Ok(_) => match (fs.write_file(path, n + "\n")) {
                    Result.Err(e) => Result.Err(e),
                    Result.Ok(_) => Result.Ok(n),
                },
            }
        }
    }
}

/// Loads or creates identity under `config_dir`. Non-empty `nick` overrides and persists.
pub fn load(config_dir: string, nick: string) -> Result<Identity, string> {
    match (load_or_create_seed(config_dir)) {
        Result.Err(e) => Result.Err(e),
        Result.Ok(seed) => {
            if (seed.len() != SEED_LEN) {
                return Result.Err("identity seed must be 32 bytes");
            }
            match (crypto.ed25519_public_key(seed)) {
                Option.None => Result.Err("could not derive public key"),
                Option.Some(pubkey) => match (load_or_create_nick(config_dir, nick)) {
                    Result.Err(e) => Result.Err(e),
                    Result.Ok(n) => complete_identity(seed, pubkey, n),
                },
            }
        },
    }
}

/// Signs `msg` with the identity seed.
pub fn sign(id: Identity, msg: bytes) -> Result<bytes, string> {
    match (crypto.ed25519_sign(id.seed, msg)) {
        Option.None => Result.Err("sign failed"),
        Option.Some(sig) => Result.Ok(sig),
    }
}

/// Verifies an Ed25519 signature.
pub fn verify(pubkey: bytes, msg: bytes, sig: bytes) -> bool {
    crypto.ed25519_verify(pubkey, msg, sig)
}

/// Updates the in-memory nick and persists it.
pub fn set_nick(id: Identity, config_dir: string, nick: string) -> Result<Identity, string> {
    let n = nick.trim();
    if (n.len() == 0) {
        return Result.Err("nick must not be empty");
    }
    if (n.len() > 32) {
        return Result.Err("nick too long (max 32)");
    }
    match (ensure_dir(config_dir)) {
        Result.Err(e) => Result.Err(e),
        Result.Ok(_) => match (fs.write_file(nick_path(config_dir), n + "\n")) {
            Result.Err(e) => Result.Err(e),
            Result.Ok(_) => Result.Ok(Identity {
                seed: id.seed,
                pubkey: id.pubkey,
                x_secret: id.x_secret,
                x_pubkey: id.x_pubkey,
                nick: n,
            }),
        },
    }
}

@test
fn fingerprint_length() {
    let seed = crypto.random_bytes(32);
    match (crypto.ed25519_public_key(seed)) {
        Option.None => panic("pubkey"),
        Option.Some(pk) => assert(fingerprint(pk).len() == 16),
    }
}

@test
fn sign_verify_roundtrip() {
    let seed = crypto.random_bytes(32);
    match (complete_identity(seed, match (crypto.ed25519_public_key(seed)) {
        Option.Some(pk) => pk,
        Option.None => panic("pk"),
    }, "t")) {
        Result.Err(e) => panic(e),
        Result.Ok(id) => {
            let msg = b"hello-msg";
            match (sign(id, msg)) {
                Result.Err(e) => panic(e),
                Result.Ok(sig) => {
                    assert(verify(id.pubkey, msg, sig));
                    assert(!verify(id.pubkey, b"other", sig));
                    assert(id.x_pubkey.len() == 32);
                },
            }
        },
    }
}

@test
fn x25519_derive_stable() {
    let seed = crypto.random_bytes(32);
    match (derive_x25519_secret(seed)) {
        Result.Err(e) => panic(e),
        Result.Ok(a) => match (derive_x25519_secret(seed)) {
            Result.Err(e) => panic(e),
            Result.Ok(b) => assert(crypto.constant_time_eq(a, b)),
        },
    }
}
