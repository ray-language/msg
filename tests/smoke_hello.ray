// Smoke: listener + dialer Hello in one process.
import std/net;
import framing;
import identity;
import protocol;

fn main() -> int {
    let dir = "/tmp/msg-smoke-id";
    match (identity.load(dir, "smoke")) {
        Result.Err(e) => { eprint(e); return 1; },
        Result.Ok(id) => {
            match (net.tcp_listen("127.0.0.1", 0)) {
                Result.Err(e) => { eprint(e); return 1; },
                Result.Ok(listener) => {
                    let port = net.local_port(listener);
                    print("port " + to_string(port));
                    let done: Channel<string> = Channel.new();
                    spawn(fn() {
                        match (net.tcp_accept(listener)) {
                            Result.Err(e) => send(done, "accept err " + e),
                            Result.Ok(h) => {
                                var c = framing.from_handle(h);
                                match (protocol.make_hello(id, port)) {
                                    Result.Err(e) => send(done, "hello " + e),
                                    Result.Ok(hello) => {
                                        match (protocol.send_hello(c, hello)) {
                                            Result.Err(e) => send(done, "send " + e),
                                            Result.Ok(c1) => {
                                                match (protocol.recv_hello(c1)) {
                                                    Result.Err(e) => send(done, "recv " + e),
                                                    Result.Ok(_) => send(done, "listener ok"),
                                                }
                                            },
                                        }
                                    },
                                }
                            },
                        }
                    });
                    match (net.tcp_connect("127.0.0.1", port)) {
                        Result.Err(e) => { eprint("connect " + e); return 1; },
                        Result.Ok(h) => {
                            var c = framing.from_handle(h);
                            match (protocol.recv_hello(c)) {
                                Result.Err(e) => { eprint("dial recv " + e); return 1; },
                                Result.Ok(pair) => {
                                    let (c1, remote) = pair;
                                    print("remote nick " + remote.nick);
                                    match (protocol.make_hello(id, port)) {
                                        Result.Err(e) => { eprint(e); return 1; },
                                        Result.Ok(hello) => {
                                            match (protocol.send_hello(c1, hello)) {
                                                Result.Err(e) => { eprint(e); return 1; },
                                                Result.Ok(_) => {
                                                    match (recv(done)) {
                                                        Option.Some(s) => { print(s); 0 },
                                                        Option.None => { eprint("no done"); 1 },
                                                    }
                                                },
                                            }
                                        },
                                    }
                                },
                            }
                        },
                    }
                },
            }
        },
    }
}
